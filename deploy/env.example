# Copy to /opt/stories/.env, fill in, then: chmod 600 .env

# latest = auto-deploy every release (story-autodeploy.timer); pin to vX.Y.Z to pause auto-deploy
APP_TAG=latest

TUNNEL_TOKEN=

POSTGRES_USER=story
POSTGRES_PASSWORD=
POSTGRES_DB=story

DATABASE_URL=postgresql+asyncpg://story:CHANGEME@db:5432/story
DATABASE_URL_SYNC=postgresql+psycopg://story:CHANGEME@db:5432/story
REDIS_URL=redis://redis:6379/0

# Fixed value - regenerating this invalidates every login session and
# every encrypted SMTP password stored in user_settings. Generate once,
# keep forever: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Only the starting value: once the app has run, admins open and close
# registration from the Users page and this is ignored. The first account
# (the admin) can always register.
ALLOW_REGISTRATION=false
STORY_FOLDER=/data/artifacts

# Default SMTP used by the CLI only; the web app stores per-user SMTP settings.
EMAIL_FROM=
EMAIL_TO=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
EMAIL_PASSWORD=

# Optional tuning (values shown are the defaults; leave commented to keep them)
# Ceilings on one scrape, so a site that never ends cannot hold a worker for
# ever (0 turns one off). Hitting the chapter or time limit ends the story with a
# note in the job log, and a retry after raising the limit carries on from there.
# Keep MAX_SCRAPE_SECONDS + CONVERSION_TIMEOUT_SECONDS below
# BROKER_VISIBILITY_TIMEOUT_SECONDS.
# MAX_CHAPTERS=20000
# MAX_SCRAPE_SECONDS=21600
# MAX_PAGE_BYTES=10485760
# Give up on Calibre after this long.
# CONVERSION_TIMEOUT_SECONDS=1800
# Redis hands a task to another worker if it is unfinished after this long, so
# it must exceed your longest scrape.
# BROKER_VISIBILITY_TIMEOUT_SECONDS=43200
# A running job's worker reports in every HEARTBEAT seconds. A job silent for
# STALE_AFTER seconds (worker crashed or was killed) is marked failed by the
# API, checked every SWEEP seconds; retry it from the UI. Keep STALE_AFTER well
# above HEARTBEAT.
# JOB_HEARTBEAT_INTERVAL_SECONDS=30
# JOB_STALE_AFTER_SECONDS=120
# STALE_JOB_SWEEP_INTERVAL_SECONDS=60
