# Postgres
POSTGRES_USER=story
POSTGRES_PASSWORD=story
POSTGRES_DB=story
DATABASE_URL=postgresql+asyncpg://story:story@db:5432/story
DATABASE_URL_SYNC=postgresql+psycopg://story:story@db:5432/story

# Redis / Celery
REDIS_URL=redis://redis:6379/0

# App
SECRET_KEY=change-me
# Only the starting value: once the app has run, admins open and close
# registration from the Users page and this is ignored. The first account
# (the admin) can always register.
ALLOW_REGISTRATION=true
STORY_FOLDER=/data/artifacts

# Default SMTP (used by the CLI; the web app stores per-user SMTP settings)
EMAIL_FROM=your_email@gmail.com
EMAIL_TO=your_kindle_address@kindle.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
EMAIL_PASSWORD=your_gmail_app_password

# Optional tuning (values shown are the defaults; leave commented to keep them)
# Give up on Calibre after this long.
# CONVERSION_TIMEOUT_SECONDS=1800
# Redis hands a task to another worker if it is unfinished after this long, so
# it must exceed your longest scrape.
# BROKER_VISIBILITY_TIMEOUT_SECONDS=43200
# A running job's worker reports in every HEARTBEAT seconds. A job silent for
# STALE_AFTER seconds (worker crashed or was killed) is marked failed by the
# API, checked every SWEEP seconds; retry it from the UI. Keep STALE_AFTER well
# above HEARTBEAT.
# JOB_HEARTBEAT_INTERVAL_SECONDS=30
# JOB_STALE_AFTER_SECONDS=300
# STALE_JOB_SWEEP_INTERVAL_SECONDS=60
